<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>validar_informe</name>
    <description>Validación automática del informe provisional</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/11/25 17:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 17:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>Autor: Asier Núñez Correa (paquete A011, cierre_aula_01)
Pregunta que resuelve: ¿el informe provisional cumple los resultados de referencia antes de publicarlo?
Group by sin claves con 'Always give back a result row' (un archivo con solo cabecera también produce una fila: n_grupos = 0 y sumas nulas).
Exige 13 grupos, 15 reservas y 3965.50 EUR; un nulo también falla. Si no cumple -&gt; Abort con error (umbral 0) y el job no publica.</note>
      <xloc>40</xloc>
      <yloc>10</yloc>
      <width>820</width>
      <heigth>100</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>205</backgroundcolorgreen>
      <backgroundcolorblue>112</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Leer informe provisional</from>
      <to>Resumir informe (sin claves)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Resumir informe (sin claves)</from>
      <to>Valores de referencia</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Valores de referencia</from>
      <to>¿Cumple la referencia?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Cumple la referencia?</from>
      <to>Informe válido</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Cumple la referencia?</from>
      <to>Informe no válido</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Leer informe provisional</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../temporal/informe_hotel_canal.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition/>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>hotel</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group></group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>canal</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group></group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>n_reservas</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal></decimal>
        <group></group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>cobrado_total</name>
        <type>BigNumber</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group></group>
        <length>-1</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Resumir informe (sin claves)</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>Y</give_back_row>
    <group>

    </group>
    <fields>
      <field>
        <aggregate>n_grupos</aggregate>
        <subject>hotel</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>suma_n_reservas</aggregate>
        <subject>n_reservas</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>suma_cobrado</aggregate>
        <subject>cobrado_total</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>260</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Valores de referencia</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>esperado_grupos</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif>13</nullif>
        <length>-1</length>
        <precision>0</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>esperado_reservas</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif>15</nullif>
        <length>-1</length>
        <precision>0</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>esperado_cobrado</name>
        <type>BigNumber</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif>3965.50</nullif>
        <length>-1</length>
        <precision>2</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>460</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>¿Cumple la referencia?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Informe válido</send_true_to>
    <send_false_to>Informe no válido</send_false_to>
    <compare>
<condition><negated>N</negated><conditions><condition><negated>N</negated><leftvalue>n_grupos</leftvalue><function>IS NOT NULL</function><rightvalue></rightvalue></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>suma_n_reservas</leftvalue><function>IS NOT NULL</function><rightvalue></rightvalue></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>suma_cobrado</leftvalue><function>IS NOT NULL</function><rightvalue></rightvalue></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>n_grupos</leftvalue><function>=</function><rightvalue>esperado_grupos</rightvalue></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>suma_n_reservas</leftvalue><function>=</function><rightvalue>esperado_reservas</rightvalue></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>suma_cobrado</leftvalue><function>=</function><rightvalue>esperado_cobrado</rightvalue></condition></conditions></condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>660</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Informe válido</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>VALIDACION OK: informe_hotel_canal.csv cumple 13 grupos, 15 reservas y 3965.50 EUR</logmessage>
    <fields>
      <field>
        <name>n_grupos</name>
      </field>
      <field>
        <name>suma_n_reservas</name>
      </field>
      <field>
        <name>suma_cobrado</name>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>880</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Informe no válido</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>VALIDACION FALLIDA: informe_hotel_canal.csv no cumple 13 grupos / 15 reservas / 3965.50 EUR (o hay nulos). No se publica.</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>880</xloc>
      <yloc>300</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
