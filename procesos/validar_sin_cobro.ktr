<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>validar_sin_cobro</name>
    <description>Validación automática del listado de reservas sin cobro</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/11/25 17:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 17:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>Autor: Asier Núñez Correa (paquete A011, cierre_aula_01)
Pregunta que resuelve: ¿el listado provisional contiene exactamente las 5 reservas sin cobro esperadas (4, 9, 11, 15 y 18), sin duplicados?
1) Cada id debe estar en la lista esperada; si no (o es nulo) -&gt; Abort.
2) Ordenar por id_reserva y contar filas por id: cada grupo debe tener 1 fila; si no -&gt; Abort.
3) Resumen sin claves con 'Always give back a result row': 5 identificadores y 5 filas; un archivo vacío da 0 -&gt; Abort.</note>
      <xloc>40</xloc>
      <yloc>10</yloc>
      <width>820</width>
      <heigth>120</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>205</backgroundcolorgreen>
      <backgroundcolorblue>112</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Leer listado provisional</from>
      <to>¿Identificador esperado?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Identificador esperado?</from>
      <to>Ordenar por id_reserva</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Identificador esperado?</from>
      <to>Identificador no esperado</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ordenar por id_reserva</from>
      <to>Contar filas por id_reserva</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Contar filas por id_reserva</from>
      <to>¿Una fila por id?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Una fila por id?</from>
      <to>Resumir listado (sin claves)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Una fila por id?</from>
      <to>Identificador duplicado</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Resumir listado (sin claves)</from>
      <to>¿5 identificadores y 5 filas?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿5 identificadores y 5 filas?</from>
      <to>Listado válido</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿5 identificadores y 5 filas?</from>
      <to>Número de filas incorrecto</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Leer listado provisional</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../temporal/reservas_sin_cobro.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition/>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>id_reserva</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal></decimal>
        <group></group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>hotel</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group></group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>canal</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group></group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>importe</name>
        <type>BigNumber</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group></group>
        <length>-1</length>
        <precision>2</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>motivo</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal></decimal>
        <group></group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>220</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>¿Identificador esperado?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Ordenar por id_reserva</send_true_to>
    <send_false_to>Identificador no esperado</send_false_to>
    <compare>
<condition><negated>N</negated><conditions><condition><negated>N</negated><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue></rightvalue><value><name>constant</name><type>Integer</type><text>4</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask>####0;-####0</mask></value></condition><condition><negated>N</negated><operator>OR</operator><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue></rightvalue><value><name>constant</name><type>Integer</type><text>9</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask>####0;-####0</mask></value></condition><condition><negated>N</negated><operator>OR</operator><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue></rightvalue><value><name>constant</name><type>Integer</type><text>11</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask>####0;-####0</mask></value></condition><condition><negated>N</negated><operator>OR</operator><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue></rightvalue><value><name>constant</name><type>Integer</type><text>15</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask>####0;-####0</mask></value></condition><condition><negated>N</negated><operator>OR</operator><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue></rightvalue><value><name>constant</name><type>Integer</type><text>18</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask>####0;-####0</mask></value></condition></conditions></condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>260</xloc>
      <yloc>220</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Identificador no esperado</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>VALIDACION FALLIDA: reservas_sin_cobro.csv contiene un id_reserva que no está en la lista esperada (4, 9, 11, 15, 18) o es nulo. No se publica.</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>260</xloc>
      <yloc>400</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Ordenar por id_reserva</name>
    <type>SortRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>id_reserva</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>460</xloc>
      <yloc>220</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Contar filas por id_reserva</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>id_reserva</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>filas_id</aggregate>
        <subject>id_reserva</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>660</xloc>
      <yloc>220</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>¿Una fila por id?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Resumir listado (sin claves)</send_true_to>
    <send_false_to>Identificador duplicado</send_false_to>
    <compare>
<condition><negated>N</negated><leftvalue>filas_id</leftvalue><function>=</function><rightvalue></rightvalue><value><name>constant</name><type>Integer</type><text>1</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask>####0;-####0</mask></value></condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>860</xloc>
      <yloc>220</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Identificador duplicado</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>VALIDACION FALLIDA: reservas_sin_cobro.csv tiene identificadores duplicados. No se publica.</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>860</xloc>
      <yloc>400</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Resumir listado (sin claves)</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>Y</give_back_row>
    <group>

    </group>
    <fields>
      <field>
        <aggregate>n_identificadores</aggregate>
        <subject>id_reserva</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>n_filas</aggregate>
        <subject>filas_id</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1060</xloc>
      <yloc>220</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>¿5 identificadores y 5 filas?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Listado válido</send_true_to>
    <send_false_to>Número de filas incorrecto</send_false_to>
    <compare>
<condition><negated>N</negated><conditions><condition><negated>N</negated><leftvalue>n_identificadores</leftvalue><function>=</function><rightvalue></rightvalue><value><name>constant</name><type>Integer</type><text>5</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask>####0;-####0</mask></value></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>n_filas</leftvalue><function>IS NOT NULL</function><rightvalue></rightvalue></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>n_filas</leftvalue><function>=</function><rightvalue></rightvalue><value><name>constant</name><type>Integer</type><text>5</text><length>-1</length><precision>0</precision><isnull>N</isnull><mask>####0;-####0</mask></value></condition></conditions></condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1260</xloc>
      <yloc>220</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Listado válido</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>VALIDACION OK: reservas_sin_cobro.csv contiene 5 reservas (4, 9, 11, 15, 18) sin duplicados</logmessage>
    <fields>
      <field>
        <name>n_identificadores</name>
      </field>
      <field>
        <name>n_filas</name>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1460</xloc>
      <yloc>140</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Número de filas incorrecto</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>VALIDACION FALLIDA: reservas_sin_cobro.csv no tiene 5 identificadores / 5 filas (o está vacío). No se publica.</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1460</xloc>
      <yloc>320</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
